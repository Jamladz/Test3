{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Registered Telegram Mini App Users",
      "type": "object",
      "properties": {
        "telegramId": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "username": { "type": "string" },
        "photoUrl": { "type": "string" },
        "balance": { "type": "number" },
        "lastMiningStartTime": { "type": "number" },
        "miningDurationMs": { "type": "number" },
        "tasksCompleted": { "type": "array", "items": { "type": "string" } },
        "referredBy": { "type": "string" },
        "weeklyReferralCount": { "type": "number" },
        "totalReferrals": { "type": "number" },
        "walletAddress": { "type": "string" },
        "season1MinedTokens": { "type": "number" },
        "season1Rank": { "type": "number" },
        "season1Claimed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["telegramId", "balance"]
    },
    "referrals": {
      "title": "Referrals",
      "description": "Log of verified referrals",
      "type": "object",
      "properties": {
        "referrerId": { "type": "string" },
        "referredUserId": { "type": "string" },
        "referredUserName": { "type": "string" },
        "referredUsername": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "rewardTokens": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["referrerId", "referredUserId"]
    }
  }
}
